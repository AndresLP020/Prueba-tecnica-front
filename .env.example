# Copiar a .env.local
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/leadflow?retryWrites=true&w=majority
MONGODB_DB=leadflow
N8N_WEBHOOK_URL=http://localhost:5678/webhook/lead-intake
N8N_WEBHOOK_SECRET=cambia-este-secreto-largo
N8N_WEBHOOK_HEADER=X-Webhook-Secret
CAL_BASE_URL=https://cal.com/orbita
APP_URL=http://localhost:3000
ADMIN_PASSWORD=cambia-admin-pass
ADMIN_SECRET=cambia-esta-clave-hmac-16+

# Correo directo (sin n8n). Gmail: contraseña de aplicación.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Gemini (https://aistudio.google.com/apikey)
LLM_API_KEY=
